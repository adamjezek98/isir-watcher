# ISIR Watcher Configuration

# Base URL where the output directory is publicly accessible
# Example: https://example.com/isir-reports
# Leave empty if not hosting reports online
BASE_URL=

# Optional: Output directory (default: output)
# OUTPUT_DIR=output

# Optional: Database URL (default: sqlite:///./isir_watcher.db)
# DATABASE_URL=sqlite:///./isir_watcher.db

# Optional: Number of retries for failed downloads (default: 3)
# MAX_DOWNLOAD_RETRIES=3

# Optional: Download timeout in seconds (default: 30)
# DOWNLOAD_TIMEOUT=30

# Optional: Consecutive invalid-link failures before reporting in changelog (default: 10)
# INVALID_LINK_THRESHOLD=10
